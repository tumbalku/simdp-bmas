# SIMDP VPS/local production-style example
# Use this when app, PostgreSQL, and document storage run on the VPS.
# Copy to the server env file; do not commit real secrets.

NEXT_PUBLIC_APP_URL=https://simdp.example.go.id

DATABASE_URL=postgresql://simdp_user:strong_password@127.0.0.1:5432/simdp
DIRECT_URL=postgresql://simdp_user:strong_password@127.0.0.1:5432/simdp

JWT_SECRET=production-long-random-secret
REFRESH_TOKEN_SECRET=production-long-random-refresh-secret
CRON_SECRET=production-long-random-cron-secret

MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

STORAGE_PROVIDER=local
SIMDP_STORAGE_DIR=/srv/simdp/uploads

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@rsud-bahteramas.go.id
SMTP_HOST=smtp.example.go.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@rsud-bahteramas.go.id
SMTP_PASS=replace-with-secret
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://simdp.example.go.id/api/v1/auth/google/callback

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
