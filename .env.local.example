# SIMDP local development example
# Use this when running the app on your laptop with local/Docker PostgreSQL and local uploads.
# Copy to `.env.local` or merge into `.env`.
# Never put real production secrets in this template.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL, for example from Docker.
# If your Docker exposes port 55432, keep this value.
DATABASE_URL=postgresql://sicantik:sicantik@localhost:55432/sicantik?schema=public
DIRECT_URL=postgresql://sicantik:sicantik@localhost:55432/sicantik

JWT_SECRET=dev-change-me-minimum-32-characters
REFRESH_TOKEN_SECRET=dev-refresh-change-me-minimum-32-characters
CRON_SECRET=dev-cron-change-me

# Aktifkan sementara jika pendaftaran mandiri pegawai dibuka.
PUBLIC_REGISTRATION_ENABLED=false

# Development can use noop if ClamAV is not running yet.
MALWARE_SCANNER_PROVIDER=noop
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

STORAGE_PROVIDER=local
SIMDP_STORAGE_DIR=D:\Real Work\Website\Final Project\SIMDP\uploads

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
