# SIMDP restore helper example
# Use this with scripts/restore-local-vps.sh.
# Restore to a temporary database/folder first; do not restore directly to production.

RESTORE_BACKUP_DIR=/mnt/c/Users/Arsi/Downloads/simdp-backup
RESTORE_TIMESTAMP=latest

RESTORE_DB_ENABLED=true
RESTORE_STORAGE_ENABLED=true

# Target database for restore.
# Prefer a temporary database first, for example simdp_restore_test.
RESTORE_DATABASE_URL=postgresql://sicantik:sicantik@localhost:5432/simdp_restore_test

# If psql is not installed on host, use Docker container psql.
RESTORE_DB_TARGET_PROVIDER=docker
RESTORE_DB_DOCKER_CONTAINER=sicantik-local-psql

# Required for database restore. This is intentionally long to prevent accidental restore.
RESTORE_CONFIRM=I_UNDERSTAND_RESTORE_OVERWRITES_DATA

# Storage restore target. The archive extracts into a `storage/` or `uploads/` folder here.
RESTORE_STORAGE_DIR=/mnt/c/Users/Arsi/Downloads/simdp-restore-test

# Required only if restoring encrypted .enc artifacts.
SIMDP_BACKUP_ENCRYPTION_PASSPHRASE_FILE=
