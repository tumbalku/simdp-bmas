# SIMDP Vercel/Supabase app runtime example
# Use this for the web app when database + storage live in Supabase.
# Copy to Vercel Environment Variables or `.env.production`.
# Do not use anon/publishable key for SUPABASE_SERVICE_ROLE_KEY.

NEXT_PUBLIC_APP_URL=https://simdp.rsud-bahteramas.go.id

# App runtime database URL.
# For Vercel/serverless, use Supabase transaction pooler from the dashboard.
# Usually port 6543 and `?pgbouncer=true`.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct/session connection for migration/admin jobs.
# If your network supports direct IPv6, direct db host is fine.
# Otherwise use session pooler on port 5432.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

JWT_SECRET=production-long-random-secret
REFRESH_TOKEN_SECRET=production-long-random-refresh-secret
CRON_SECRET=production-long-random-cron-secret

# Vercel cannot run local ClamAV unless a scanner service is provided.
# Use noop only if you knowingly accept that tradeoff.
MALWARE_SCANNER_PROVIDER=noop
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

DEPLOYMENT_CONTEXT=vercel-supabase
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_secret_key_from_project_settings
SUPABASE_STORAGE_BUCKET=employee-documents

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Keep backup disabled in app runtime unless a dedicated job/worker uses these envs.
BACKUP_ENABLED=false
BACKUP_DB_ENABLED=true
BACKUP_STORAGE_ENABLED=true
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_TARGET=gdrive
BACKUP_LOCAL_DIR=
BACKUP_FOLDER_PATH=
BACKUP_DATABASE_URL=
BACKUP_DB_DUMP_PROVIDER=docker-image
BACKUP_DB_DOCKER_CONTAINER=
BACKUP_DB_DOCKER_IMAGE=postgres:17-alpine

GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=

BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_DAYS=56
BACKUP_RETENTION_MONTHLY_DAYS=365

EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=no-reply@rsud-bahteramas.go.id
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://simdp.rsud-bahteramas.go.id/api/v1/auth/google/callback

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
