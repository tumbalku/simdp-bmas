# SIMDP environment example
# Copy file ini ke `.env.local` atau `.env.production`, lalu isi sesuai skenario deploy.
# Jangan simpan secret asli di repository.
#
# Cara baca cepat:
# - Kalau ada komentar "wajib", isi nilai itu dulu.
# - Kalau ada beberapa contoh, pilih yang sesuai deployment kamu.
# - Kalau tidak dipakai, biarkan kosong atau pakai nilai default contoh.
#
# Template yang lebih sederhana:
# - `.env.local.example`            : development lokal + Docker PostgreSQL + storage local.
# - `.env.supabase.example`         : runtime app Vercel/Supabase.
# - `.env.vps-local.example`        : VPS dengan PostgreSQL dan uploads lokal.
#
# Cara pakai:
# 1. Pilih template yang cocok.
# 2. Copy isinya ke `.env`, `.env.local`, atau env dashboard Vercel/VPS.
# 3. Ganti semua placeholder seperti PROJECT_REF, PASSWORD, sb_secret_..., dan domain.
# 4. Jangan commit file env asli.
#
# Catatan penting:
# - `SUPABASE_SERVICE_ROLE_KEY` harus memakai `sb_secret_...`, bukan `sb_publishable_...`.
# - `DATABASE_URL` untuk Vercel biasanya memakai Transaction Pooler port 6543 + `?pgbouncer=true`.

############################################
# 1) APP / URL
############################################
# URL publik aplikasi.
# Contoh lokal:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contoh production:
# NEXT_PUBLIC_APP_URL=https://simdp.rsud-bahteramas.go.id

############################################
# 2) DATABASE
############################################
# Connection string PostgreSQL utama yang dipakai aplikasi.
# Contoh lokal/dev PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simdp

# Contoh Supabase/PostgreSQL remote:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true

# DIRECT_URL dipakai untuk koneksi direct ke database, biasanya untuk migration/admin job.
# Contoh lokal/dev:
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/simdp

# Contoh Supabase direct connection:
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

############################################
# 3) AUTH / SECURITY
############################################
# Secret untuk JWT access token.
# Contoh aman minimal: string panjang, acak, dan tidak dipakai ulang.
JWT_SECRET=dev-change-me-minimum-32-characters

# Secret untuk refresh token.
REFRESH_TOKEN_SECRET=dev-refresh-change-me-minimum-32-characters

# Secret untuk endpoint cron internal.
CRON_SECRET=dev-cron-change-me

############################################
# 4) MALWARE SCANNING
############################################
# Provider scan upload file.
# - clamav = scan nyata via clamd
# - noop   = tidak scan, hanya untuk skenario dev/tes tertentu
MALWARE_SCANNER_PROVIDER=clamav

# Host service clamd.
# Contoh lokal:
CLAMAV_HOST=127.0.0.1

# Port service clamd.
CLAMAV_PORT=3310

# Timeout scan per file dalam milidetik.
CLAMAV_TIMEOUT_MS=10000

############################################
# 5) STORAGE PROVIDER
############################################
# STORAGE_PROVIDER menentukan di mana file dokumen aplikasi disimpan.
# Ini BUKAN target backup.
#
# Pilihan:
# - local    = simpan file di folder lokal server
# - supabase = simpan file di Supabase Storage
# - s3       = simpan file di bucket S3-compatible
#
# Contoh deployment lokal/VPS:
STORAGE_PROVIDER=local

# Contoh deployment Vercel + Supabase:
# STORAGE_PROVIDER=supabase

# Jika STORAGE_PROVIDER=local, folder aktif yang dipakai aplikasi.
# Contoh lokal:
SIMDP_STORAGE_DIR=D:\Real Work\Website\Final Project\SIMDP\uploads

# Contoh Linux VPS:
# SIMDP_STORAGE_DIR=/srv/simdp/uploads

# Kalau STORAGE_PROVIDER=supabase, isi 3 variabel ini:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents

# Contoh Supabase storage:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_STORAGE_BUCKET=employee-documents

# Kalau STORAGE_PROVIDER=s3, isi variabel ini:
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contoh S3-compatible:
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_REGION=ap-southeast-1
# S3_BUCKET=simdp-documents
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...

# Optional local PDF browser path.
# Production/serverless biasanya memakai @sparticuz/chromium.
# Contoh Windows Chrome lokal:
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

############################################
# 6) EMAIL
############################################
# Provider email:
# - noop   = tidak kirim email
# - resend = pakai Resend
# - smtp   = pakai SMTP
EMAIL_PROVIDER=noop

# Contoh Resend:
# RESEND_API_KEY=re_...
RESEND_API_KEY=

# Email pengirim.
# Contoh:
# EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# Contoh SMTP Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contoh SMTP Outlook / server lain:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=app-password-atau-secret

############################################
# 7) GOOGLE OAUTH / LOGIN
############################################
# Dipakai kalau login Google diaktifkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI harus sama persis dengan yang didaftarkan di Google Cloud Console.
# Contoh lokal:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Contoh production:
# GOOGLE_OAUTH_REDIRECT_URI=https://simdp.rsud-bahteramas.go.id/api/v1/auth/google/callback

############################################
# 8) REALTIME / PUSHER
############################################
# Dipakai kalau fitur realtime / notifikasi push diaktifkan.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

############################################
# 9) BACKGROUND JOB / INNGEST
############################################
# Key untuk event publishing Inngest.
INNGEST_EVENT_KEY=

# Wajib di runtime production agar webhook Inngest diverifikasi.
INNGEST_SIGNING_KEY=
