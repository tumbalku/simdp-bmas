# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simdp
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/simdp

# Auth
JWT_SECRET=dev-change-me-minimum-32-characters
REFRESH_TOKEN_SECRET=dev-refresh-change-me-minimum-32-characters

# Storage: local | supabase | s3
STORAGE_PROVIDER=local
# Optional local PDF browser path. Production/serverless uses @sparticuz/chromium.
# PUPPETEER_EXECUTABLE_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cron / Email
CRON_SECRET=dev-cron-change-me

# Storage: stmp | noop |resend
EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Google OAuth/OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Realtime / Pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Background Job / Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
