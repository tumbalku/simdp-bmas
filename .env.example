# SIMDP environment example
# Copy file ini ke `.env.local` atau `.env.production`, lalu isi sesuai skenario deploy.
# Jangan simpan secret asli di repository.
#
# Cara baca cepat:
# - Kalau ada komentar "wajib", isi nilai itu dulu.
# - Kalau ada beberapa contoh, pilih yang sesuai deployment kamu.
# - Kalau tidak dipakai, biarkan kosong atau pakai nilai default contoh.
#
# Template yang lebih sederhana:
# - `.env.local.example`            : development lokal + Docker PostgreSQL + storage local.
# - `.env.supabase.example`         : runtime app Vercel/Supabase.
# - `.env.backup-supabase.example`  : job backup database + storage dari Supabase ke folder lokal.
# - `.env.vps-local.example`        : VPS dengan PostgreSQL dan uploads lokal.
# - `.env.restore-local.example`    : restore backup ke database/folder sementara.
#
# Cara pakai:
# 1. Pilih template yang cocok.
# 2. Copy isinya ke `.env`, `.env.local`, atau env dashboard Vercel/VPS.
# 3. Ganti semua placeholder seperti PROJECT_REF, PASSWORD, sb_secret_..., dan domain.
# 4. Jangan commit file env asli.
#
# Catatan penting:
# - `SUPABASE_SERVICE_ROLE_KEY` harus memakai `sb_secret_...`, bukan `sb_publishable_...`.
# - `BACKUP_DATABASE_URL` untuk Supabase sebaiknya memakai Session Pooler port 5432.
# - `DATABASE_URL` untuk Vercel biasanya memakai Transaction Pooler port 6543 + `?pgbouncer=true`.
# - `BACKUP_TARGET` adalah tujuan backup; `STORAGE_PROVIDER` adalah sumber/penyimpanan dokumen aplikasi.

############################################
# 1) APP / URL
############################################
# URL publik aplikasi.
# Contoh lokal:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contoh production:
# NEXT_PUBLIC_APP_URL=https://simdp.rsud-bahteramas.go.id

############################################
# 2) DATABASE
############################################
# Connection string PostgreSQL utama yang dipakai aplikasi.
# Contoh lokal/dev PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simdp

# Contoh Supabase/PostgreSQL remote:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true

# DIRECT_URL dipakai untuk koneksi direct ke database, biasanya untuk migration/admin job.
# Contoh lokal/dev:
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/simdp

# Contoh Supabase direct connection:
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

############################################
# 3) AUTH / SECURITY
############################################
# Secret untuk JWT access token.
# Contoh aman minimal: string panjang, acak, dan tidak dipakai ulang.
JWT_SECRET=dev-change-me-minimum-32-characters

# Secret untuk refresh token.
REFRESH_TOKEN_SECRET=dev-refresh-change-me-minimum-32-characters

# Secret untuk endpoint cron internal.
CRON_SECRET=dev-cron-change-me

############################################
# 4) MALWARE SCANNING
############################################
# Provider scan upload file.
# - clamav = scan nyata via clamd
# - noop   = tidak scan, hanya untuk skenario dev/tes tertentu
MALWARE_SCANNER_PROVIDER=clamav

# Host service clamd.
# Contoh lokal:
CLAMAV_HOST=127.0.0.1

# Port service clamd.
CLAMAV_PORT=3310

# Timeout scan per file dalam milidetik.
CLAMAV_TIMEOUT_MS=10000

############################################
# 5) STORAGE PROVIDER
############################################
# STORAGE_PROVIDER menentukan di mana file dokumen aplikasi disimpan.
# Ini BUKAN target backup.
#
# Pilihan:
# - local    = simpan file di folder lokal server
# - supabase = simpan file di Supabase Storage
# - s3       = simpan file di bucket S3-compatible
#
# Contoh deployment lokal/VPS:
DEPLOYMENT_CONTEXT=hybrid
STORAGE_PROVIDER=local

# Contoh deployment Vercel + Supabase:
# DEPLOYMENT_CONTEXT=vercel-supabase
# STORAGE_PROVIDER=supabase

# Contoh VPS yang tetap membaca file dari bucket Supabase:
# DEPLOYMENT_CONTEXT=vps-local
# STORAGE_PROVIDER=supabase

# Jika STORAGE_PROVIDER=local, folder aktif yang dipakai aplikasi.
# Contoh lokal:
SIMDP_STORAGE_DIR=D:\Real Work\Website\Final Project\SIMDP\uploads

# Contoh Linux VPS:
# SIMDP_STORAGE_DIR=/srv/simdp/uploads

# Kalau STORAGE_PROVIDER=supabase, isi 3 variabel ini:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents

# Contoh Supabase storage:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_STORAGE_BUCKET=employee-documents

# Kalau STORAGE_PROVIDER=s3, isi variabel ini:
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contoh S3-compatible:
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_REGION=ap-southeast-1
# S3_BUCKET=simdp-documents
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...

# Optional local PDF browser path.
# Production/serverless biasanya memakai @sparticuz/chromium.
# Contoh Windows Chrome lokal:
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

############################################
# 6) BACKUP / RECOVERY
############################################
# BACKUP_TARGET adalah tujuan artefak backup, bukan sumber dokumen.
# STORAGE_PROVIDER = sumber file aplikasi.
# BACKUP_TARGET    = tempat backup disimpan / dikirim.
#
# Pilihan BACKUP_TARGET:
# - local   = simpan ke folder lokal
# - folder  = simpan ke folder mounted / NAS / volume backup
# - gdrive  = upload ke Google Drive via service account
# - s3      = upload ke bucket backup S3-compatible
#
# Prioritas backup production yang disarankan:
# 1. gdrive
# 2. local/folder
# 3. s3
BACKUP_ENABLED=false
BACKUP_DB_ENABLED=true
BACKUP_STORAGE_ENABLED=true
BACKUP_ENCRYPTION_ENABLED=false

# URL khusus pg_dump. Kosongkan kalau DATABASE_URL sudah aman untuk pg_dump.
# Biasanya dipakai kalau DATABASE_URL aplikasi punya query parameter Prisma seperti ?schema=public.
# Contoh Docker PostgreSQL dari dalam container:
# BACKUP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simdp
BACKUP_DATABASE_URL=

# Cara membuat dump database:
# - auto   = pakai pg_dump lokal kalau ada, fallback ke Docker kalau container diisi
# - local  = wajib ada pg_dump di host/VPS
# - docker = pakai pg_dump dari container PostgreSQL
# - docker-image = pakai pg_dump dari Docker image, cocok kalau butuh versi tertentu
BACKUP_DB_DUMP_PROVIDER=auto

# Isi kalau BACKUP_DB_DUMP_PROVIDER=docker atau auto fallback Docker.
# Contoh container lokal project ini:
# BACKUP_DB_DOCKER_CONTAINER=sicantik-local-psql
BACKUP_DB_DOCKER_CONTAINER=

# Isi kalau BACKUP_DB_DUMP_PROVIDER=docker-image.
# Contoh Supabase PostgreSQL 17:
# BACKUP_DB_DOCKER_IMAGE=postgres:17-alpine
BACKUP_DB_DOCKER_IMAGE=postgres:17-alpine

# Contoh backup ke folder lokal:
BACKUP_TARGET=local
BACKUP_LOCAL_DIR=

# Contoh backup ke folder/NAS mounted:
# BACKUP_TARGET=folder
# BACKUP_FOLDER_PATH=/var/backups/simdp

# Penjelasan singkat:
# - BACKUP_LOCAL_DIR dipakai kalau BACKUP_TARGET=local
# - BACKUP_FOLDER_PATH dipakai kalau BACKUP_TARGET=folder

# Contoh Google Drive service account:
# BACKUP_TARGET=gdrive
# GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GDRIVE_CLIENT_EMAIL=simdp-backup-uploader@project.iam.gserviceaccount.com
# GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=

# Contoh S3 target backup:
# BACKUP_TARGET=s3
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_REGION=ap-southeast-1
# S3_BUCKET=simdp-backup
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...

# Retention backup.
# Contoh umum:
# - harian 14 hari
# - mingguan 56 hari
# - bulanan 365 hari
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_DAYS=56
BACKUP_RETENTION_MONTHLY_DAYS=365

############################################
# 6B) RESTORE / RECOVERY HELPER
############################################
# Dipakai oleh scripts/restore-local-vps.sh.
# Default aman: restore ke environment/folder terpisah dulu, jangan langsung production.

# Folder yang berisi hasil backup.
# Contoh Windows via WSL/Git Bash:
# RESTORE_BACKUP_DIR=/mnt/c/Users/Arsi/Downloads/simdp-backup
RESTORE_BACKUP_DIR=

# Pilih backup mana yang direstore.
# - latest = manifest terbaru
# - YYYYMMDD_HHmmSS = timestamp tertentu dari nama file backup
RESTORE_TIMESTAMP=latest

# Pilih bagian yang direstore.
RESTORE_DB_ENABLED=true
RESTORE_STORAGE_ENABLED=true

# URL database tujuan restore.
# Untuk Docker PostgreSQL, URL ini dilihat dari dalam container, jadi biasanya port 5432.
# Contoh:
# RESTORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simdp_restore
RESTORE_DATABASE_URL=

# Cara menjalankan psql untuk restore database:
# - auto   = pakai psql lokal kalau ada, fallback ke Docker kalau container diisi
# - local  = wajib ada psql di host/VPS
# - docker = pakai psql dari container PostgreSQL
RESTORE_DB_TARGET_PROVIDER=auto

# Isi kalau RESTORE_DB_TARGET_PROVIDER=docker.
# Contoh:
# RESTORE_DB_DOCKER_CONTAINER=sicantik-local-psql
RESTORE_DB_DOCKER_CONTAINER=

# Konfirmasi wajib untuk restore database sungguhan.
# Ini sengaja panjang agar tidak tidak sengaja menimpa/merge data.
# RESTORE_CONFIRM=I_UNDERSTAND_RESTORE_OVERWRITES_DATA
RESTORE_CONFIRM=

# Folder tujuan extract storage restore.
# Contoh test aman:
# RESTORE_STORAGE_DIR=/mnt/c/Users/Arsi/Downloads/simdp-restore-test
RESTORE_STORAGE_DIR=

############################################
# 7) EMAIL
############################################
# Provider email:
# - noop   = tidak kirim email
# - resend = pakai Resend
# - smtp   = pakai SMTP
EMAIL_PROVIDER=noop

# Contoh Resend:
# RESEND_API_KEY=re_...
RESEND_API_KEY=

# Email pengirim.
# Contoh:
# EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# Contoh SMTP Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contoh SMTP Outlook / server lain:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=app-password-atau-secret

############################################
# 8) GOOGLE OAUTH / LOGIN
############################################
# Dipakai kalau login Google diaktifkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI harus sama persis dengan yang didaftarkan di Google Cloud Console.
# Contoh lokal:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Contoh production:
# GOOGLE_OAUTH_REDIRECT_URI=https://simdp.rsud-bahteramas.go.id/api/v1/auth/google/callback

############################################
# 9) REALTIME / PUSHER
############################################
# Dipakai kalau fitur realtime / notifikasi push diaktifkan.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

############################################
# 10) BACKGROUND JOB / INNGEST
############################################
# Key untuk event publishing Inngest.
INNGEST_EVENT_KEY=

# Wajib di runtime production agar webhook Inngest diverifikasi.
INNGEST_SIGNING_KEY=
