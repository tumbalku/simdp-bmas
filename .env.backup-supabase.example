# SIMDP Supabase backup worker example
# Use this on a laptop/VPS/job runner to pull Supabase database + Supabase Storage,
# then save backup artifacts to a local folder.
# Copy to a private env file such as `.env.backup-supabase`; never commit real values.

# Output folder for backup artifacts.
BACKUP_ENABLED=true
BACKUP_TARGET=local
BACKUP_LOCAL_DIR=/mnt/c/Users/Arsi/Downloads/simdp-backup
BACKUP_FOLDER_PATH=

# What to backup.
BACKUP_DB_ENABLED=true
BACKUP_STORAGE_ENABLED=true

# Test mode only. Production/offsite backup should use encryption.
BACKUP_ENCRYPTION_ENABLED=false
SIMDP_BACKUP_ALLOW_UNENCRYPTED=true
SIMDP_BACKUP_ENCRYPTION_PASSPHRASE_FILE=

# Supabase database dump URL.
# Use Session Pooler on port 5432 for pg_dump, not transaction pooler port 6543.
# Remove `?pgbouncer=true`; pg_dump does not need Prisma query parameters.
BACKUP_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase PostgreSQL version 17 needs pg_dump 17.
# The backup script can run pg_dump from this Docker image.
BACKUP_DB_DUMP_PROVIDER=docker-image
BACKUP_DB_DOCKER_IMAGE=postgres:17-alpine
BACKUP_DB_DOCKER_CONTAINER=

# Supabase Storage source.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_secret_key_from_project_settings
SUPABASE_STORAGE_BUCKET=employee-documents

# Optional app/database values. Usually not needed by the backup script when BACKUP_DATABASE_URL is set.
DATABASE_URL=
DIRECT_URL=

BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_DAYS=56
BACKUP_RETENTION_MONTHLY_DAYS=365
