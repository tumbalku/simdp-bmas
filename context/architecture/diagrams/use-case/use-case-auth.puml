@startuml use-case-auth
skinparam actorStyle stickman
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial

title SIMDP - Use Case: Autentikasi & Keamanan Sesi

actor employee as "Pegawai / Staff / Admin\n(Semua User)"
actor system as "Sistem (Auto)"

rectangle "Autentikasi & Keamanan Sesi" {
    usecase UC01 as "UC-01 Login\n(NIP / NIK / Email + Password)"
    usecase UC02 as "UC-02 Logout\n& Revoke Refresh Token"
    usecase UC03 as "UC-03 Lupa Password\n(Request Reset Link via Email)"
    usecase UC04 as "UC-04 Reset Password\n(via Token 1 Jam)"
    usecase UC05 as "UC-05 Ubah Password\n(Saat Login)"
    usecase UC06 as "UC-06 Auto Refresh Token\n(Setiap 20 Menit)"
    usecase UC07 as "UC-07 Single-Device Enforcement\n(Revoke Sesi Lama Saat Login Baru)"
}

employee --> UC01
employee --> UC02
employee --> UC03
employee --> UC04
employee --> UC05

system --> UC06
UC01 ..> UC07 : "<<include>>"
UC04 ..> UC02 : "<<include>>\n(revoke all tokens)"

@enduml
